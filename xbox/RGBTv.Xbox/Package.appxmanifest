<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <!-- Identity Name/Publisher are replaced automatically when you use Project > Publish > Associate App with the Store.
       For Dev-Mode sideloading any values work; the Publisher must match the signing certificate (see README). -->
  <Identity Name="RGBTv.Xbox" Publisher="CN=RGBTv" Version="2.1.0.0" />
  <mp:PhoneIdentity PhoneProductId="6f4b9a9c-2d7e-4f1a-9c3e-8a1b2c3d4e5f" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>RGBTv</DisplayName>
    <PublisherDisplayName>RGBTv</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="RGBTv.Xbox.App">
      <uap:VisualElements
        DisplayName="RGBTv"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="RGBTv — IPTV player (Live TV, Movies, Series)"
        BackgroundColor="#0B0F19">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B0F19" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <!-- more graphics memory + 4K/HEVC decoding for video apps on Xbox -->
    <rescap:Capability Name="hevcPlayback" />
  </Capabilities>
</Package>
