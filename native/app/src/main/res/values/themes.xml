        <item name="colorSecondary">@color/accent_green</item>
    </style>
    <style name="Overlay.Accent.Red" parent="">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorSecondary">@color/accent_red</item>
    </style>
    <style name="Overlay.Accent.Purple" parent="">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorSecondary">@color/accent_purple</item>
    </style>
    <style name="Overlay.Accent.Gold" parent="">
        <item name="colorPrimary">@color/accent_gold</item>
        <item name="colorSecondary">@color/accent_gold</item>
    </style>
