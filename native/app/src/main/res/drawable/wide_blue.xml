<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#40C4FF" android:endColor="#1565C0" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#B3E5FC" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#1E88E5" android:endColor="#0D2C6E" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#2E5A9B" />
        </shape>
    </item>
</selector>
