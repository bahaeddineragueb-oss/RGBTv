<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00E6B8" android:endColor="#00897B" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#8DF5DC" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00B894" android:endColor="#005B4F" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#2E8B7D" />
        </shape>
    </item>
</selector>
