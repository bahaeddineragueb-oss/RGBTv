<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="135" android:startColor="#7DFFB2" android:endColor="#0E7A45" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass2" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="135" android:startColor="@color/neon_green" android:endColor="#08452A" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
